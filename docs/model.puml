@startuml "model"

class Client {
    id: Long
    cpf: String
    name: String
    phone: String
    sex: Sex
    active: boolean
    tenantId: Integer
}

class User {
    id: Integer
    name: String
    email: String
    password: String
    active: boolean
    tenantId: Integer
}

class Role {
    id: Integer
    role: RoleName
}

class Product {
    id: Long
    code: String
    name: String
    costPrice: BigDecimal
    retailPrice: BigDecimal
    tenantId: Integer
}

class Frame {
    category: FrameCategory
    stockQuantity: Integer
}

class Lenses {
    lensType: LensType
}

class Sale {
    id: Long
    issueDate: LocalDate
    estimatedDeliveryDate: LocalDate
    deliveryDate: LocalDate
    totalAmount: BigDecimal
    paymentMethod: PaymentMethod
    cardBrand: CardBrand
    installments: Integer
    comments: String
    saleStatus: SaleStatus
    tenantId: Integer
}

class SaleItem {
    id: Long
    unitPrice: BigDecimal
    tenantId: Integer
}

class Invoice {
    id: Long
    number: Long
    serial: String
    tenantId: Integer
}

class ServiceOrder {
    id: Long
    pdfPath: String
    tenantId: Integer
}

class Prescription {
    id: Long
    date: LocalDate
    ophthalmologist: Ophthalmologist
    od_sphere: Float
    od_cylinder: Float
    od_axis: Integer
    os_sphere: Float
    os_cylinder: Float
    os_axis: Integer
    addition: Float
    notes: String
    tenantId: Integer
}

class Ophthalmologist {
    name: String
    phone: String
}

class Unit {
    name: String
    logo: String
    tenantId: Integer
}

Client      "1"          o--      "0..*"    Sale
Sale        "1"          o-d-     "1..*"    SaleItem
SaleItem    "1"          o-r->    "1"       Product
Sale        "1"          -u->     "0..1"    Invoice
Sale        "1"          -u-      "0..1"    ServiceOrder
User        "1"          o--      "0..*"    Sale
Client      "1"          o--     "0..*"     Prescription
Product                  <|--               Frame
Product                  <|--               Lenses
User                  o-->   "0..*"  Role
Ophthalmologist  "1"     o--     "0..*"    Prescription

@enduml